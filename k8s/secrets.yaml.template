# ==============================================================================
# MarkDriller Kubernetes Secret Template
# WARNING: DO NOT COMMIT REAL PRODUCTION VALUES TO VERSION CONTROL.
# In production, inject secrets via SealedSecrets, ExternalSecrets (AWS Secrets Manager/Vault),
# or CI/CD deployment environment secrets.
# ==============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: markdriller-secrets
  namespace: markdriller
  labels:
    app.kubernetes.io/name: markdriller
    app.kubernetes.io/component: secrets
type: Opaque
stringData:
  # Database URI (Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/markdriller?retryWrites=true&w=majority)
  MONGODB_URI: "mongodb+srv://REPLACE_WITH_PRODUCTION_DB_USER:REPLACE_WITH_PRODUCTION_DB_PASSWORD@cluster0.mongodb.net/markdriller"
  
  # Cryptographic Secrets (Must be at least 32 random characters in production)
  JWT_SECRET: "REPLACE_WITH_CRYPTO_SECURE_JWT_SECRET_AT_LEAST_32_CHARS"
  SESSION_SECRET: "REPLACE_WITH_CRYPTO_SECURE_SESSION_SECRET_32_CHARS"
  
  # Paystack Production Keys
  PAYSTACK_SECRET_KEY: "sk_live_REPLACE_WITH_PAYSTACK_PRODUCTION_SECRET_KEY"
  PAYSTACK_PUBLIC_KEY: "pk_live_REPLACE_WITH_PAYSTACK_PRODUCTION_PUBLIC_KEY"
  PAYSTACK_WEBHOOK_SECRET: "whsec_REPLACE_WITH_PAYSTACK_WEBHOOK_SECRET"
  
  # Transactional Email Credentials
  EMAIL_USER: "REPLACE_WITH_BREVO_OR_SMTP_LOGIN_EMAIL"
  EMAIL_PASSWORD: "REPLACE_WITH_BREVO_OR_SMTP_API_KEY"
  BREVO_API_KEY: "xkeysib-REPLACE_WITH_BREVO_API_KEY"
  
  # Cloudinary Storage Credentials (If STORAGE_PROVIDER is cloudinary)
  CLOUDINARY_CLOUD_NAME: "REPLACE_WITH_CLOUDINARY_CLOUD_NAME"
  CLOUDINARY_API_KEY: "REPLACE_WITH_CLOUDINARY_API_KEY"
  CLOUDINARY_API_SECRET: "REPLACE_WITH_CLOUDINARY_API_SECRET"
  
  # Dynamic Question Acquisition Credentials
  QUESTION_SOURCE_API_URL: "https://api.source.markdriller.com/v1"
  QUESTION_SOURCE_API_KEY: "REPLACE_WITH_AUTHORIZED_QUESTION_FEED_KEY"
