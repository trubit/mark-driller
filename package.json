{
  "name": "mark-driller",
  "version": "1.0.0",
  "description": "Full-stack exam preparation platform for West African secondary and university students (WAEC, NECO, JAMB/UTME), built with React, TypeScript, MUI, Bootstrap, Zustand, TanStack Query, and Express.",
  "private": true,
  "type": "module",
  "main": "dist/server/index.js",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"blue,green\" \"npm run server:dev\" \"node scripts/wait-for-server.js && vite\"",
    "dev:web": "vite",
    "server:dev": "tsx watch src/server/index.ts",
    "build": "tsc -b && vite build && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "worker:start": "node dist/server/worker.js",
    "worker:dev": "tsx watch src/server/worker.ts",
    "preview": "vite preview",
    "db:index": "tsx scripts/ensure-production-indexes.ts",
    "type-check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "tsx scripts/verify-security-hardening.ts && tsx scripts/verify-4000-concurrency.ts && tsx scripts/verify-expansion-layout.ts",
    "test:all": "tsx scripts/verify-security-hardening.ts && tsx scripts/verify-4000-concurrency.ts && tsx scripts/verify-expansion-layout.ts && tsx scripts/verify-paystack-e2e.ts && tsx scripts/verify-student-journey-e2e.ts",
    "test:access": "tsx scripts/verify-access-control.ts",
    "test:email": "tsx scripts/verify-brevo.ts",
    "test:sync": "tsx scripts/verify-question-sync.ts",
    "test:paystack": "tsx scripts/verify-paystack-e2e.ts",
    "test:expansion": "tsx scripts/verify-expansion-layout.ts",
    "test:journey": "tsx scripts/verify-student-journey-e2e.ts",
    "test:security": "tsx scripts/verify-security-hardening.ts",
    "test:concurrency": "tsx scripts/verify-4000-concurrency.ts",
    "test:platform": "tsx scripts/verify-full-production-platform.ts"
  },
  "keywords": [
    "mark-driller",
    "exam-prep",
    "waec",
    "jamb",
    "neco",
    "cbt-practice",
    "past-questions",
    "react",
    "typescript",
    "express"
  ],
  "author": "Mark Driller Team",
  "license": "ISC",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.4.5",
    "@mui/material": "^6.4.5",
    "@paystack/inline-js": "^2.25.0",
    "@tanstack/react-query": "^5.66.9",
    "bcryptjs": "^3.0.2",
    "bootstrap": "^5.3.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.10.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "react": "^18.3.1",
    "react-bootstrap": "^2.10.9",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.1"
  }
}
